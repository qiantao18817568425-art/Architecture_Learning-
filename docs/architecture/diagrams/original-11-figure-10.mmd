flowchart TD
  A["ADAS 告警异常"] --> B{"触发与源状态有效?"}
  B -- 否 --> B1["CAN/E2E 无效或陈旧"]
  B -- 是 --> C{"数据/Buffer/音频流推进?"}
  C -- 否 --> C1["跨域 Topic/缓存过期"]
  C -- 是 --> D{"策略、合成或路由正确?"}
  D -- 否 --> D1["优先级或抑制状态错误"]
  D -- 是 --> E{"物理输出与反馈闭环?"}
  E -- 否 --> E1["音画输出不同步或物理输出失败"]
  B1 --> R["新 Generation/Session 恢复"]
  C1 --> R
  D1 --> R
  E1 --> R
